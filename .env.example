# Copy to .env to override defaults. All upstream URLs must be localhost
# unless ALLOW_LAN=1 (the app is designed to run 100% locally).
OLLAMA_URL=http://127.0.0.1:11434
VOICESTUDIO_URL=http://127.0.0.1:3900
DEFAULT_MODEL=gemma4:latest
HOST=127.0.0.1
PORT=8080
# DATA_DIR=./data
# ALLOW_LAN=0

# VoiceStudio: Initial setup generates and stores its own key in data/secrets.json.
# Set this only to use a VoiceStudio you installed yourself that has a key.
# VOICESTUDIO_API_KEY=
# Image installed by Initial setup:
# VOICESTUDIO_IMAGE=ghcr.io/debpalash/voicestudio:stable
# Speech-to-text model pinned in the container (default: Whisper small on CPU,
# large-v3-turbo with a GPU):
# AVTAAR_ASR_MODEL=Systran/faster-whisper-small
